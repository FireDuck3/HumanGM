# Local UCI engines. Download Stockfish from stockfishchess.org/download/.
STOCKFISH_PATH=engines/stockfish/stockfish/stockfish-windows-x86-64-universal.exe
STOCKFISH_ARGS_JSON=[]
# Official Maia-3 source is in vendor/maia3; setup-engines.cmd adds its runtime.
MAIA3_PATH=.venv/Scripts/python.exe
MAIA3_ARGS=scripts/maia3_uci.py --model maia3-5m --use-uci-history --device cpu --no-use-amp --cache-dir data/maia-cache --local-files-only

ENGINE_MOVE_TIME=1.5
ENGINE_CANDIDATES=6
STOCKFISH_THREADS=4
STOCKFISH_HASH_MB=128
MAIA_THREADS=2
MAIA_MOVE_TIME=0.5
MAIA_START_TIMEOUT=180
